\newcommand{\tableofcontentsheadline}[0]{
    \setbeamertemplate{headline}{
        \pgfsetstrokeopacity{0}
        \pgfsetfillopacity{0}
        \vskip1mm
        \insertnavigation{\paperwidth}
        \vskip2mm
        \pgfsetstrokeopacity{1}
        \pgfsetfillopacity{1}
    }
    \setbeamercolor{frametitle}{fg=white,bg=}
    \setbeamertemplate{background canvas}{
        \tikz[remember picture,overlay]{
            \backgradient
            \usetitledecoration
        }
    }
}

\newcommand{\tableofcontentsfootline}[0]{
    \setbeamertemplate{footline}{}
}

\newcommand{\tocframe}[1][sectionstyle=show,subsectionstyle=show]{
    {
        \miniframesoff
        \tableofcontentsheadline
        \tableofcontentsfootline
        \begin{frame}[noframenumbering]{Sumário}
            \tableofcontents[#1]
        \end{frame}
        \miniframeson
    }
}

\newcommand{\autotocframe}[1]{\AtBeginSection[]{\ifstrempty{#1}{\tocframe}{\tocframe[#1]}}}

