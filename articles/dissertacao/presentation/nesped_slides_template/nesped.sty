% --- specialframe ---

\newcommand{\backgradient}[0]{
    \path [left color=primary, right color=secondary, shading=axis, shading angle=45]
        (current page.south west)
        rectangle
        (current page.north east);
}

\newcommand{\specialframe}[0]{
    \setbeamercolor{normal text}{fg=white}
    \setbeamercolor{local structure}{fg=white}
    \setbeamercolor{frametitle}{fg=white,bg=}
    % \setbeamercolor{block title}{bg=white,fg=primaryshade}
    \setbeamertemplate{headline}{
        \begin{beamercolorbox}[wd=\paperwidth]{headline}
            \vskip1mm
            \insertnavigation{\paperwidth}
            \vskip1mm
        \end{beamercolorbox}
        \vskip0.6mm
    }
    \setbeamercolor{footline}{fg=white,bg=}
    \setbeamertemplate{background canvas}{
        \tikz{
            \backgradient
        }
    }
    \usebeamercolor[fg]{normal text}
}

% --- title ---

\setbeamerfont{title}{series=\scshape, size=\Large, series=\bfseries}
\setbeamerfont{subtitle}{series=\mdseries, size=\normalsize, series=\bfseries}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{date}{size=\normalsize}

\newcommand{\titlelogo}[1]{
    \hspace{2mm}
    \begin{tikzpicture}[every shadow/.style={opacity=.2,fill=black}]
        \node[
            rectangle,rounded corners=1mm,draw=white,
            drop shadow,fill=white,ultra thin,
            minimum width=0.15\paperwidth,minimum height=1.6cm,
        ] (b) {};
        \node[anchor=south] at ($(b.south)+(0,1mm)$) {
            \includegraphics[width=0.1\paperwidth,max height=1cm]{#1}
        };
    \end{tikzpicture}
}


\setbeamertemplate{title page}{
    \hspace{-12mm}
    \begin{beamercolorbox}[wd=0.9\textwidth, sep=8mm, leftskip=2mm]{title}
        \vskip12pt{\usebeamerfont{title}\inserttitle}\\
        \vskip5pt{\usebeamerfont{subtitle}\insertsubtitle}\\
        \vskip10pt{}
        \vskip5pt{\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor}\\
        \vskip5pt{\usebeamerfont{institute}\usebeamercolor[fg]{author}\insertinstitute}\\
        \vskip5pt{\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate}
    \end{beamercolorbox}
}


\newcommand{\titleframe}[1]{
    \begingroup
        \setbeamercolor{normal text}{fg=white,bg=}
        \setbeamercolor{structure}{fg=white,bg=}
        \setbeamercolor{author}{fg=white,bg=}
        \setbeamercolor{institute}{fg=white,bg=}
        \setbeamercolor{date}{fg=white,bg=}
        \setbeamertemplate{background}{}
        \setbeamertemplate{headline}{
            \vskip-2mm
            \hspace{6mm}
            #1
        }
        \setbeamertemplate{background canvas}{
            \tikz[remember picture,overlay]{
                \backgradient
                \usetitledecoration
            }
        }
        \setbeamertemplate{footline}{}
        \begin{frame}[noframenumbering]
            \titlepage
        \end{frame}
    \endgroup
}

